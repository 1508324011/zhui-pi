{
  "lastChangelogVersion": "0.83.0",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "max",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-lens",
    "npm:pi-web-access",
    "npm:pi-rtk-optimizer",
    "npm:pi-cache-optimizer",
    "npm:pi-deepseek-search",
    "npm:@cortexkit/pi-magic-context",
    "../../zhui-pi/packages/pi-sakura-cyberdeck"
  ],
  "theme": "synthwave",
  "subagents": {
    "defaultThinking": "max",
    "agentOverrides": {
      "advisor": {
        "disabled": true
      },
      "worker": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      },
      "context-builder": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      },
      "researcher": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      },
      "delegate": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "max"
      },
      "scout": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "max"
      },
      "planner": {
        "model": "zhui/gpt-5.5",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "zhui/gpt-5.6-sol",
        "thinking": "max"
      },
      "oracle": {
        "model": "zhui/gpt-5.6-sol",
        "thinking": "max"
      },
      "trellis-implement": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      },
      "trellis-check": {
        "model": "zhui/gpt-5.6-sol",
        "thinking": "max"
      },
      "trellis-research": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      }
    },
    "watchdog": {
      "enabled": true,
      "main": {
        "model": "zhui/gpt-5.5",
        "thinking": "xhigh"
      },
      "scope": {
        "enabled": true
      },
      "autoFollow": {
        "blockers": true,
        "maxAttempts": 3,
        "stalemateRepeats": 3
      },
      "lsp": {
        "enabled": true
      }
    }
  }
}
