{
  "lastChangelogVersion": "0.83.0",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "max",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-lens",
    "npm:pi-web-access",
    "npm:pi-rtk-optimizer",
    "npm:pi-cache-optimizer",
    "npm:pi-deepseek-search"
  ],
  "theme": "dark",
  "subagents": {
    "defaultThinking": "max",
    "agentOverrides": {
      "advisor": {
        "disabled": true
      },
      "worker": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      },
      "context-builder": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      },
      "researcher": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      },
      "delegate": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "max"
      },
      "scout": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "max"
      },
      "planner": {
        "model": "zhui/gpt-5.5",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "zhui/gpt-5.6-sol",
        "thinking": "max"
      },
      "oracle": {
        "model": "zhui/gpt-5.6-sol",
        "thinking": "max"
      }
    }
  }
}