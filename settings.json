{
  "lastChangelogVersion": "0.84.4",
  "quietStartup": true,
  "defaultProvider": "zhui",
  "defaultModel": "glm-5.3",
  "defaultThinkingLevel": "xhigh",
  "packages": [
    "npm:pi-mcp-adapter@2.32.1",
    "npm:pi-subagents@0.63.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.9.0",
    "npm:@juicesharp/rpiv-todo@2.9.0",
    "npm:@gotgenes/pi-permission-system@30.0.0",
    "npm:pi-lens@4.1.3",
    "npm:pi-web-access@0.27.0",
    "npm:pi-cache-optimizer@2.8.6",
    "npm:pi-deepseek-search",
    "npm:@cortexkit/pi-magic-context@0.41.1",
    "../../zhui-pi/packages/pi-sakura-cyberdeck",
    "npm:@earendil-works/pi-coding-agent@0.84.4"
  ],
  "theme": "synthwave",
  "subagents": {
    "defaultThinking": "max",
    "agentOverrides": {
      "advisor": {
        "disabled": true
      },
      "worker": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      },
      "researcher": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      },
      "delegate": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "max"
      },
      "scout": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "max"
      },
      "reviewer": {
        "model": "zhui/gpt-5.6-sol",
        "thinking": "max"
      },
      "oracle": {
        "model": "zhui/gpt-5.6-sol",
        "thinking": "max"
      },
      "trellis-implement": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      },
      "trellis-check": {
        "model": "zhui/gpt-5.6-sol",
        "thinking": "max"
      },
      "trellis-research": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "max"
      }
    },
    "watchdog": {
      "enabled": true,
      "main": {
        "model": "zhui/gpt-5.5",
        "thinking": "xhigh"
      },
      "scope": {
        "enabled": true
      },
      "autoFollow": {
        "blockers": true,
        "maxAttempts": 3,
        "stalemateRepeats": 3
      },
      "lsp": {
        "enabled": true
      }
    }
  }
}